# ResearchMind AI Engine (backend-ai) Environment Variables

# Primary LLM API Key (Get free key from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: OpenAI Key fallback
# OPENAI_API_KEY=your_openai_api_key_here

# Optional: Semantic Scholar API Key for high rate limits
# SEMANTIC_SCHOLAR_API_KEY=your_semantic_scholar_key_here
